<Window x:Class="SimplePLC.Studio.Views.DirectWriteConfigDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SimplePLC.Studio.Services"
        xmlns:controls="clr-namespace:SimplePLC.Studio.Controls"
        xmlns:vm="clr-namespace:SimplePLC.Studio.ViewModels"
        Title="{Binding [DirectWriteDialogTitle], Source={x:Static services:LocalizationService.Instance}}"
        Width="580"
        MinWidth="540"
        Height="440"
        SizeToContent="Height"
        ResizeMode="CanResizeWithGrip"
        controls:WindowChromeHelper.EnableIndependentMinimize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{DynamicResource BgAppBrush}"
        Icon="../Assets/app.png"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Icons.xaml" />
                <ResourceDictionary Source="../Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- 0. Header -->
                <RowDefinition Height="Auto" />
                <!-- 1. Form Content -->
                <RowDefinition Height="Auto" />
                <!-- 2. Footer Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header (Industrial Slate & Vector Icon) -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                    <Path Data="{StaticResource IconIecTriggerPulse}" Style="{StaticResource IecStatusIconStyle}" Width="16" Height="16" Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [DirectWriteDialogTitle], Source={x:Static services:LocalizationService.Instance}}" 
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Subtitle}" 
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- 1. Content Body (Single Column Fluent 2 Cards) -->
            <StackPanel Grid.Row="1">

                <!-- Card 1: Hardware Pin & Operating Mode (Balanced 2-Row Grid to prevent label clipping) -->
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding [DirectWriteSectionHardware], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Row 0: Target Pin & Mode -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <!-- Row 2: Trigger Mode & Contextual Note -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Row 0, Col 0: Target Hardware Pin -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWriteTargetPinLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteTargetPinTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableTargetPins}" 
                                          ToolTip="{Binding [DirectWriteTargetPinTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                          SelectedValue="{Binding TargetPin}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                          Height="28" Padding="8,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                            </StackPanel>

                            <!-- Row 0, Col 2: Operating Mode -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{Binding [DirectWriteModeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableModes}" 
                                          ToolTip="{Binding [DirectWriteModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                          SelectedValue="{Binding Mode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                          Height="28" Padding="8,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                            </StackPanel>

                            <!-- Row 2, Col 0: Trigger Mechanism -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWriteTriggerModeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteTriggerModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableTriggerModes}" 
                                          ToolTip="{Binding [DirectWriteTriggerModeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                          SelectedValue="{Binding TriggerMode}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                          Height="28" Padding="8,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                            </StackPanel>

                            <!-- Row 2, Col 2: Contextual Trigger Mechanism Helper -->
                            <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text=" " FontSize="11" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                                        BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" 
                                        BorderThickness="1" CornerRadius="4" Padding="10,0" Height="28">
                                    <TextBlock Text="{Binding TriggerDescriptionText}" 
                                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" 
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" 
                                               ToolTip="{Binding TriggerDescriptionText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Contextual Parameters per Mode -->
                <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding [DirectWriteSectionParameters], Source={x:Static services:LocalizationService.Instance}}" 
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,10" />

                        <!-- Mode 0: Digital Output (DO) -->
                        <Grid Visibility="{Binding IsDigitalOutputMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWriteActiveLevelLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteActiveLevelTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableActiveLevels}" 
                                          ToolTip="{Binding [DirectWriteActiveLevelTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                          SelectedValue="{Binding IsActiveHigh}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                          Height="28" Padding="8,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [DirectWriteFailSafeLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteFailSafeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableFailSafeStates}" 
                                          ToolTip="{Binding [DirectWriteFailSafeTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                          SelectedValue="{Binding FailSafeState}" SelectedValuePath="Value" DisplayMemberPath="DisplayName" 
                                          Height="28" Padding="8,4" FontSize="11" VerticalContentAlignment="Center" BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Mode 1: PWM Duty Cycle -->
                        <Grid Visibility="{Binding IsPwmMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWritePwmFreqLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWritePwmFreqTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PwmFrequencyHz, UpdateSourceTrigger=LostFocus}" 
                                         ToolTip="{Binding [DirectWritePwmFreqTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [DirectWriteDutyMinLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteDutyMinTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DutyMin, UpdateSourceTrigger=LostFocus}" 
                                         ToolTip="{Binding [DirectWriteDutyMinTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding [DirectWriteDutyMaxLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteDutyMaxTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DutyMax, UpdateSourceTrigger=LostFocus}" 
                                         ToolTip="{Binding [DirectWriteDutyMaxTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" />
                            </StackPanel>
                        </Grid>

                        <!-- Mode 2: Pulse Train Output (PTO) -->
                        <Grid Visibility="{Binding IsPulseTrainMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWritePtoPulsesLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWritePtoPulsesTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FallbackPulses, UpdateSourceTrigger=LostFocus}" 
                                         ToolTip="{Binding [DirectWritePtoPulsesTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [DirectWritePtoFreqLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWritePtoFreqTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PwmFrequencyHz, UpdateSourceTrigger=LostFocus}" 
                                         ToolTip="{Binding [DirectWritePtoFreqTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{Binding [DirectWritePulseWidthLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWritePulseWidthTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PulseWidthUs, UpdateSourceTrigger=LostFocus}" 
                                         ToolTip="{Binding [DirectWritePulseWidthTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" />
                            </StackPanel>
                        </Grid>

                        <!-- Mode 3: Generic Addressable Actuator Bus -->
                        <Grid Visibility="{Binding IsAddressableBusMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [DirectWriteChannelCountLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteChannelCountTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding ChannelCount, UpdateSourceTrigger=LostFocus}" 
                                         ToolTip="{Binding [DirectWriteChannelCountTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [DirectWriteDefaultColorLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                           ToolTip="{Binding [DirectWriteDefaultColorTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DefaultColorHex, UpdateSourceTrigger=LostFocus}" 
                                         ToolTip="{Binding [DirectWriteDefaultColorTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                         Height="28" Padding="6,4" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" />
                            </StackPanel>

                            <CheckBox Grid.Column="4" IsChecked="{Binding IsExclusiveChannel}" 
                                      ToolTip="{Binding [DirectWriteExclusiveCheckTooltip], Source={x:Static services:LocalizationService.Instance}}"
                                      VerticalAlignment="Bottom" Margin="0,0,0,6"
                                      Content="{Binding [DirectWriteExclusiveChannelLabel], Source={x:Static services:LocalizationService.Instance}}" 
                                      FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- 2. Footer Action Bar (Compact IBM Carbon / ISA-101) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Configuration Summary Badge -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource IndustrialSurfaceInsetBrush}" 
                        BorderBrush="{DynamicResource IndustrialBorderSubtleBrush}" 
                        BorderThickness="1" CornerRadius="4" Padding="10,5" 
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0"
                        ToolTip="{Binding [DirectWriteSummaryBadgeTooltip], Source={x:Static services:LocalizationService.Instance}}">
                    <TextBlock Text="{Binding SummaryBadgeText}" 
                               FontFamily="Cascadia Code, Consolas" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>

                <!-- Right: Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding [BtnCancel], Source={x:Static services:LocalizationService.Instance}}" 
                            ToolTip="{Binding [DirectWriteBtnCancelTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Click="Cancel_Click"
                            Style="{StaticResource TiaTactileBtnStyle}"
                            FontSize="11.5" Height="28" Padding="16,4" Margin="0,0,8,0" />

                    <Button Content="{Binding [DirectWriteBtnApply], Source={x:Static services:LocalizationService.Instance}}" 
                            ToolTip="{Binding [DirectWriteBtnApplyTooltip], Source={x:Static services:LocalizationService.Instance}}"
                            Click="Apply_Click"
                            IsEnabled="{Binding HasAvailablePins}"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="11.5" Height="28" Padding="20,4" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>