<UserControl x:Class="SimplePLC.Studio.Controls.ToastHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SimplePLC.Studio.Models"
             xmlns:services="clr-namespace:SimplePLC.Studio.Services"
             xmlns:converters="clr-namespace:SimplePLC.Studio.Converters"
             IsHitTestVisible="True"
             Focusable="False">

    <UserControl.Resources>
        <!-- Converter: Boolean & Null to Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <!-- Floating Toast Container (Bottom-Right) -->
    <ItemsControl ItemsSource="{Binding Source={x:Static services:ToastNotificationService.Instance}, Path=ActiveToasts}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:ToastNotification}">
                <Border x:Name="ToastCard"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource IndustrialBorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        MinWidth="280"
                        MaxWidth="380"
                        Margin="0,0,0,8"
                        Padding="12,10"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.12" />
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Indicator Icon -->
                        <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                            <!-- Success Icon -->
                            <Path x:Name="IconSuccess" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysCheckCircle}"
                                  Stroke="{DynamicResource SuccessBrush}" Width="16" Height="16" Visibility="Collapsed" />
                            <!-- Info Icon -->
                            <Path x:Name="IconInfo" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysInfo}"
                                  Stroke="{DynamicResource PrimaryBrush}" Width="16" Height="16" Visibility="Collapsed" />
                            <!-- Warning Icon -->
                            <Path x:Name="IconWarning" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysAlertTriangle}"
                                  Stroke="{DynamicResource WarningBrush}" Width="16" Height="16" Visibility="Collapsed" />
                            <!-- Error Icon -->
                            <Path x:Name="IconError" Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysAlertCircle}"
                                  Stroke="{DynamicResource DangerBrush}" Width="16" Height="16" Visibility="Collapsed" />
                        </Grid>

                        <!-- Message Body & Action -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15" />

                            <!-- Optional Action Button (e.g. Undo) -->
                            <Button Content="{Binding ActionText}"
                                    Command="{Binding ActionCommand}"
                                    Style="{StaticResource TactileToolbarBtnStyle}"
                                    Visibility="{Binding ActionText, Converter={StaticResource NullToVis}}"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Padding="8,2"
                                    FontSize="10.5"
                                    FontWeight="SemiBold" />
                        </StackPanel>

                        <!-- Dismiss Button (X) -->
                        <Button Grid.Column="2"
                                Click="DismissButton_Click"
                                Width="20" Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Top"
                                Padding="2">
                            <Path Style="{StaticResource IecStatusIconStyle}" Data="{StaticResource IconSysClear}"
                                  Stroke="{DynamicResource TextMutedBrush}" Width="9" Height="9" />
                        </Button>
                    </Grid>
                </Border>

                <!-- DataTemplate Triggers for ToastType styling -->
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ToastType.Success}">
                        <Setter TargetName="IconSuccess" Property="Visibility" Value="Visible" />
                        <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ToastType.Info}">
                        <Setter TargetName="IconInfo" Property="Visibility" Value="Visible" />
                        <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ToastType.Warning}">
                        <Setter TargetName="IconWarning" Property="Visibility" Value="Visible" />
                        <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ToastType.Error}">
                        <Setter TargetName="IconError" Property="Visibility" Value="Visible" />
                        <Setter TargetName="ToastCard" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
